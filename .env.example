# ===================================================================
# Ukázková konfigurace proměnných prostředí pro testovací projekt
# Pro lokální přepsání zkopírujte tento soubor jako .env
# ===================================================================

# Základní URL testované aplikace
BASE_URL=http://testovani.kitner.cz

# Režim spuštění prohlížeče (true = headless bez okna, false = s oknem)
HEADLESS=true

# Zpomalení akcí v ms (pro debugování např. 500)
BROWSER_SLOWMO=0

# Výchozí timeout pro lokátory (v ms)
DEFAULT_TIMEOUT=30000
